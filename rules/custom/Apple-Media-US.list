# ==============================================================================
# Rule Name: Apple-Media-US (Custom)
# Target Policy: US Test (or US)
# Description: Apple services restricted to US region (Apple TV+, Apple News, Fitness+, TestFlight)
# ==============================================================================

# --- Apple TV+ & Media Streaming ---
DOMAIN-SUFFIX,tv.apple.com
DOMAIN-SUFFIX,play-edge.itunes.apple.com
DOMAIN-SUFFIX,hls.itunes.apple.com
DOMAIN-SUFFIX,hls-amt.itunes.apple.com
DOMAIN-SUFFIX,linear.tv.apple.com

# --- Apple News ---
DOMAIN-SUFFIX,news-assets.apple.com
DOMAIN-SUFFIX,news-client.apple.com
DOMAIN-SUFFIX,news-edge.apple.com
DOMAIN-SUFFIX,apple.news

# --- Apple Fitness+ ---
DOMAIN-SUFFIX,amp-api.fitness.apple.com
DOMAIN-SUFFIX,fitness.apple.com

# --- TestFlight ---
DOMAIN-SUFFIX,testflight.apple.com
